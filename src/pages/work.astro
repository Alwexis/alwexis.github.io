---
import Layout from "../layouts/Layout.astro";
import WorkCard from "../components/WorkCard.astro";
import { getCollection } from "astro:content";
import type { WorkEntry } from "../types";

const works: WorkEntry[] = await getCollection("works");

const sortedWorks = [...works].sort(
  (a, b) => (b.data.priority ?? 0) - (a.data.priority ?? 0),
);
---

<Layout
  title='Ariel Silva — Work Archive'
  description='Complete archive of engineering projects, web applications, machine learning systems, and software tools.'>
  <div class='flex flex-col w-full pb-12'>
    <header
      class='flex items-baseline justify-between border-b border-neutral-200 dark:border-border-dark pb-4 pt-6 mb-12'>
      <div class='flex items-center gap-3'>
        <a
          href='/'
          class='font-mono text-xs text-muted dark:text-body-dark hover:text-black dark:hover:text-white transition-colors flex items-center gap-1 select-none'
          title='Back to home'>
          <span>&lt;--</span>
        </a>
        <h1
          class='text-lg font-semibold tracking-tight uppercase text-primary-light dark:text-emphasis'>
          WORK.
        </h1>
      </div>
      <div
        class='text-[11px] font-mono text-muted dark:text-body-dark tracking-wider uppercase'>
        {sortedWorks.length.toString().padStart(2, "0")} PROJECTS
      </div>
    </header>

    <div class='divide-y divide-neutral-200 dark:divide-border-dark'>
      {
        sortedWorks.map((work) => (
          <WorkCard
            work={work}
            extended
            headingTag='h2'
            class='group transition-colors duration-150 px-2 -mx-2 rounded-xs'
          />
        ))
      }
    </div>
  </div>
</Layout>
