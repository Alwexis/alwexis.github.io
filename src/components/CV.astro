---
import { cvDownloads } from "../data/constants";
---

<section class='pt-24 pb-18' id='cv'>
  <div class='flex items-baseline justify-between mb-6'>
    <h2
      class='text-LG font-semibold tracking-tight uppercase text-primary-light dark:text-emphasis'>
      Curriculum Vitae.
    </h2>
    <span class='text-[11px] font-mono text-muted dark:text-body-dark'
      >FORMAT: PDF</span
    >
  </div>
  <div
    class='flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-3'>
    <div>
      <p class='text-sm font-medium text-primary-light dark:text-primary-dark'>
        Complete Engineering Résumé
      </p>
      <p class='text-xs text-muted dark:text-body-dark mt-0.5'>
        Work chronology, academic qualifications, and technical competencies.
      </p>
    </div>
    <div class='flex items-center gap-3 text-xs font-mono'>
      {
        cvDownloads.map((cv) => (
          <a
            class='px-3 py-1.5 border border-neutral-300 dark:border-border-dark rounded-xs text-primary-light dark:text-primary-dark hover:border-black dark:hover:border-neutral-500 transition-colors inline-flex items-center gap-1.5'
            download={cv.filename}
            href={cv.url}>
            <span>{cv.label}</span>
            <span class='text-neutral-400 dark:text-neutral-600'>↓</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
